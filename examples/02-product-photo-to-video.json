{
  "name": "Turbogen: product photo to video",
  "nodes": [
    {
      "parameters": {},
      "id": "t1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://example.com/product-photo.jpg",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "h1",
      "name": "Download Product Photo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "resource": "video",
        "operation": "generate",
        "model": "veo-3.1-fast",
        "aspect": "9:16",
        "option": "6s",
        "prompt": "Slow orbit around the product on a clean studio table, soft light sweeping across the surface.",
        "refs": "data",
        "wait": true
      },
      "id": "g1",
      "name": "Animate Photo",
      "type": "n8n-nodes-turbogen.turbogen",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "credentials": {
        "turbogenApi": {
          "id": "",
          "name": "Turbogen account"
        }
      }
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "inputDataFieldName": "data",
        "name": "product-video.mp4",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "list",
          "value": "root",
          "cachedResultName": "/ (Root folder)"
        },
        "options": {}
      },
      "id": "d1",
      "name": "Upload to Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        660,
        0
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "",
          "name": "Google Drive account"
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Download Product Photo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download Product Photo": {
      "main": [
        [
          {
            "node": "Animate Photo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Animate Photo": {
      "main": [
        [
          {
            "node": "Upload to Google Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}