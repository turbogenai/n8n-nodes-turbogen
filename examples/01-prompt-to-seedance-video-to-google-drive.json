{
  "name": "Turbogen: prompt to Seedance 2.5 video to Google Drive",
  "nodes": [
    {
      "parameters": {},
      "id": "t1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "prompt",
              "value": "Slow dolly-in on a lighthouse at dusk, waves breaking on the rocks, warm light in the lantern room.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "s1",
      "name": "Prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "resource": "video",
        "operation": "generate",
        "model": "seedance-2.5",
        "aspect": "16:9",
        "option": "5s",
        "prompt": "={{ $json.prompt }}",
        "wait": true,
        "options": {
          "timeoutMinutes": 15
        }
      },
      "id": "g1",
      "name": "Generate Video",
      "type": "n8n-nodes-turbogen.turbogen",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "credentials": {
        "turbogenApi": {
          "id": "",
          "name": "Turbogen account"
        }
      }
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "inputDataFieldName": "data",
        "name": "turbogen-video.mp4",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "list",
          "value": "root",
          "cachedResultName": "/ (Root folder)"
        },
        "options": {}
      },
      "id": "d1",
      "name": "Upload to Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        660,
        0
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "",
          "name": "Google Drive account"
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prompt": {
      "main": [
        [
          {
            "node": "Generate Video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Video": {
      "main": [
        [
          {
            "node": "Upload to Google Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}